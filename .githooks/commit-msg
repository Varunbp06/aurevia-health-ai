#!/bin/sh
set -eu
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo "commit-msg: refusing to proceed." >&2
    exit 2
fi
# Only reject the footer on its own line OR a co-authored trailer
# "Generated with Codebuff" appearing in the body (not as footer) is allowed
pattern='^Generated with Codebuff$|^Generated with Codebuff[[:space:]]|^Co-authored-by:.*codebuff|^Co-authored-by:.*noreply@codebuff'
if grep -qE "$pattern" "$1" 2>/dev/null; then
    echo "commit-msg: rejected a prohibited Codebuff-generated signature." >&2
    echo "Remove the footer or co-author trailer and retry." >&2
    exit 1
fi
exit 0
