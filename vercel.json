{
  "version": 2,
  "buildCommand": "npx tsc -p frontend/tsconfig.json --noEmit && npx vite build --config frontend/vite.config.ts",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "env": {
    "VITE_PUBLIC_API_URL": "@vite_public_api_url"
  }
}